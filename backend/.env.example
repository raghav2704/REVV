# Local development (no real credentials are included).
REVV_ENV=development
DATABASE_URL=postgresql+psycopg://localhost/revv_db
REVV_COOKIE_SECURE=false
# Production MUST set REVV_ENV=production, HTTPS-only exact origins,
# REVV_COOKIE_SECURE=true, explicit API hostnames, and a private persistent path.
# REVV_ALLOWED_ORIGINS=https://revv.example
# REVV_ALLOWED_HOSTS=api.revv.example,revv.example
# REVV_RATE_LIMIT_PATH=/var/lib/revv/security/limits.sqlite3
# Remote PostgreSQL needs sslmode=verify-full and a trusted CA; use a runtime
# role without SUPERUSER, CREATEDB or CREATEROLE. Never put credentials in git.

# Smart Car Finder: local deterministic rules only; no API key is needed.
REVV_AI_PROVIDER=rules
